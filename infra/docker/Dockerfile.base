FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pip setuptools wheel
CMD ["python", "-c", "print('base image ready')"]
