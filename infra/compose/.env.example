# ============================================================
# quant-os Environment Configuration
# ============================================================
# Copy this to .env and fill in real values for each environment
# ============================================================

# -------------------- Database --------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quantos
POSTGRES_USER=quantos
POSTGRES_PASSWORD=change-me-in-production

# -------------------- Redis --------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# -------------------- Prefect --------------------
PREFECT_API_KEY=
PREFECT_API_URL=http://prefect:4200/api
PREFECT_API_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -------------------- Grafana --------------------
GRAFANA_PASSWORD=admin

# -------------------- Prometheus --------------------
PROMETHEUS_RETENTION_TIME=15d

# -------------------- Shared --------------------
LOG_LEVEL=INFO
TZ=UTC

# -------------------- Signal Bridge --------------------
WEBHOOK_SECRET=change-me-in-production
SIGNAL_KEY_PREFIX=signal_bridge:
ACK_KEY_PREFIX=signal_ack:
DEAD_LETTER_QUEUE=dead_letter_signals
MAX_RETRIES=3
SIGNAL_TTL=900

# -------------------- Data Gateway --------------------
BINANCE_ENABLED=true
POLYMARKET_ENABLED=true
CACHE_TTL=300

# -------------------- Event Gateway --------------------
EVENT_STREAM_KEY=events:stream
EVENT_TTL=3600
EVENT_DEDUP_WINDOW=60
CONSUMER_GROUP=quant-os-consumers
CONSUMER_NAME=quant-os-${HOSTNAME:-default}

# -------------------- Feature Service --------------------
FEATURE_CACHE_TTL=600

# -------------------- Research Runner --------------------
FEATURE_SERVICE_URL=http://feature_service:8094
SIGNAL_BRIDGE_URL=http://signal_bridge:8090
DATA_GATEWAY_URL=http://data_gateway:8091

# -------------------- Orchestrator --------------------
EVENT_GATEWAY_URL=http://event_gateway:8092
FEATURE_SERVICE_URL=http://feature_service:8094
SIGNAL_BRIDGE_URL=http://signal_bridge:8090
RESEARCH_RUNNER_URL=http://research_runner:8099
EXECUTION_CONTROL_URL=http://execution_control:8097
RISK_CONTROL_URL=http://risk_control:8096

# -------------------- Execution Control --------------------
RISK_CONTROL_URL=http://risk_control:8096
EXECUTION_MODE=paper  # paper | shadow | live

# -------------------- Risk Control --------------------
KILL_SWITCH_THRESHOLD_PCT=20
MAX_DRAWDOWN_PCT=15
MAX_POSITION_SIZE_PCT=30

# -------------------- Service Ports (for local dev) --------------------
#DATA_GATEWAY_PORT=8091
#EVENT_GATEWAY_PORT=8092
#SIGNAL_PUBLISHER_PORT=8093
#FEATURE_SERVICE_PORT=8094
#ORCHESTRATOR_PORT=8095
#RISK_CONTROL_PORT=8096
#EXECUTION_CONTROL_PORT=8097
#REPORT_GENERATOR_PORT=8098
#SIGNAL_BRIDGE_PORT=8090
#RESEARCH_RUNNER_PORT=8099
#OPS_DASHBOARD_PORT=3000
#ANALYTICS_PORT=3010